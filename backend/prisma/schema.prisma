generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  WAREHOUSE_MANAGER
}

enum AccessLevel {
  NONE
  MANAGE
}

model Company {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  locality  String?
  city      String?
  state     String?
  pincode   String?
  status    String   @default("Active")
  createdAt DateTime @default(now())

  warehouses Warehouse[]
  users      User[]
}

model Warehouse {
  id       String  @id @default(uuid())
  name     String
  code     String  @unique
  locality String?
  city     String
  state    String
  pincode  String

  Inward  String @default("Active")
  Outward String @default("Active")

  createdAt DateTime @default(now())

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  access    WarehouseAccess[]
  grns      Grn[]
  mins      Min[]
  models    WarehouseModel[]
  companies WarehouseCompany[]
  auditLogs AuditLog[]

  @@index([companyId])
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  warehouseAccess WarehouseAccess[]
  grns            Grn[]
  mins            Min[]
  documents       Document[]
  auditLogs       AuditLog[]
}

model WarehouseAccess {
  id          String @id @default(uuid())
  userId      String
  warehouseId String

  accessLevel AccessLevel @default(NONE)

  canInward          Boolean @default(false)
  canOutward         Boolean @default(false)
  canManageDocuments Boolean @default(false)

  grantedAt DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([userId, warehouseId])
  @@index([warehouseId])
  @@index([userId])
}

model Grn {
  id String @id @default(uuid())

  grnNumber  String @unique
  inwardType String

  supplierName String
  companyName  String?

  refDocType     String
  refDocNumber   String
  refDocDate     DateTime
  ewayBillNumber String?
  remarks        String?

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  items              GrnItem[]
  referenceDocuments GrnReferenceDocument[]

  @@index([warehouseId])
  @@index([createdById])
}

model GrnItem {
  id String @id @default(uuid())

  grnId       String
  category    String
  companyName String?
  sku         String
  quantity    Int
  uom         String

  grn Grn @relation(fields: [grnId], references: [id], onDelete: Cascade)

  @@index([grnId])
  @@index([category, companyName])
}

model GrnReferenceDocument {
  id String @id @default(uuid())

  grnId String

  refDocType     String
  refDocNumber   String?
  ewayBillNumber String?
  createdAt      DateTime @default(now())

  grn Grn @relation(fields: [grnId], references: [id], onDelete: Cascade)

  @@index([grnId])
}

model Min {
  id String @id @default(uuid())

  outwardNumber String @unique
  outwardType   String

  customerName String
  companyName  String?

  refDocType     String
  refDocNumber   String
  refDocDate     DateTime
  ewayBillNumber String?

  dispatchMode  String?
  vehicleNumber String?
  remarks       String?

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  items              MinItem[]
  referenceDocuments MinReferenceDocument[]

  @@index([warehouseId])
  @@index([createdById])
}

model MinItem {
  id String @id @default(uuid())

  minId      String
  category   String
  companyName String?
  sku        String
  quantity   Int
  uom        String

  min Min @relation(fields: [minId], references: [id], onDelete: Cascade)

  @@index([minId])
  @@index([category, companyName])
}

model MinReferenceDocument {
  id String @id @default(uuid())

  minId String

  refDocType     String
  refDocNumber   String?
  ewayBillNumber String?
  createdAt      DateTime @default(now())

  min Min @relation(fields: [minId], references: [id], onDelete: Cascade)

  @@index([minId])
}

model WarehouseCompany {
  id String @id @default(cuid())

  warehouseId String
  name        String
  createdAt   DateTime @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, name])
  @@index([warehouseId])
}

model WarehouseModel {
  id String @id @default(uuid())

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  category    String
  companyName String?
  name        String

  createdAt DateTime @default(now())

  @@unique([warehouseId, category, companyName, name])
  @@index([warehouseId])
  @@index([warehouseId, category, companyName])
}

model Document {
  id String @id @default(uuid())

  linkedType  String
  linkedId    String
  docCategory String

  fileKey  String
  fileType String
  fileSize Int

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  uploadedAt DateTime @default(now())

  @@index([linkedType, linkedId])
  @@index([uploadedById])
  @@index([docCategory])
}

model AuditLog {
  id String @id @default(uuid())

  entityType   String
  entityId     String
  entityNumber String

  action      String
  description String
  changes     Json?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([entityNumber])
  @@index([userId])
  @@index([warehouseId])
  @@index([createdAt])
}
